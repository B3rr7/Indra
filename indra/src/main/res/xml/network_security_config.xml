<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) is permitted ONLY for loopback.

  Rationale: the OTA updater's test mode (`SettingsRepository.otaAllowTestHosts`)
  uses `adb reverse tcp:` so a LAN build server appears as 127.0.0.1 on the
  device. Production OTA traffic stays HTTPS-pinned; everything else is
  cleartext-blocked by the base config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
